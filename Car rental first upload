<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trinidad Car Rentals</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
        }
        header {
            background-color: #007bff;
            color: white;
            padding: 15px;
            text-align: center;
        }
        .container {
            width: 80%;
            margin: auto;
            padding: 20px;
        }
        .car {
            border: 1px solid #ddd;
            padding: 15px;
            margin: 10px 0;
            background-color: white;
            display: flex;
            flex-wrap: wrap;
        }
        .car img {
            width: 200px;
            height: auto;
            margin-right: 20px;
        }
        .car-info {
            flex: 1;
        }
        button {
            background-color: #28a745;
            color: white;
            padding: 10px;
            border: none;
            cursor: pointer;
        }
        button:hover {
            background-color: #218838;
        }
        footer {
            background-color: #343a40;
            color: white;
            text-align: center;
            padding: 10px;
            position: absolute;
            width: 100%;
            bottom: 0;
        }

        /* Booking Form Styles */
        .popup-form {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 20px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);
            z-index: 1000;
        }
        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }
        .form-group {
            margin-bottom: 10px;
        }
        .form-group label {
            display: block;
            font-weight: bold;
        }
        .form-group input {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
        }
        .close-btn {
            background-color: red;
            color: white;
            padding: 5px 10px;
            border: none;
            cursor: pointer;
            float: right;
        }

        /* Mobile responsiveness */
        @media (max-width: 768px) {
            .container {
                width: 100%;
                padding: 10px;
            }
            .car {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>
<body>

<header>
    <h1>Trinidad Car Rentals</h1>
    <p>Reliable and Affordable Car Rentals</p>
</header>

<div class="container">
    <h2>Available Cars</h2>
    <div class="car">
        <img src="economy_car.jpg" alt="Economy Car">
        <div class="car-info">
            <h3>Economy Car</h3>
            <p><strong>Price:</strong> $250 TTD/day</p>
            <p><strong>Features:</strong> Air Conditioning, Bluetooth, 4 Seats, Fuel Efficient</p>
            <button onclick="openForm('Economy Car')">Rent Now</button>
        </div>
    </div>

    <div class="car">
        <img src="intermediate_car.jpg" alt="Intermediate Car">
        <div class="car-info">
            <h3>Intermediate Car</h3>
            <p><strong>Price:</strong> $350 TTD/day</p>
            <p><strong>Features:</strong> Air Conditioning, Bluetooth, 5 Seats, Spacious</p>
            <button onclick="openForm('Intermediate Car')">Rent Now</button>
        </div>
    </div>
</div>

<!-- Popup Form -->
<div class="overlay" id="overlay"></div>
<div class="popup-form" id="popupForm">
    <button class="close-btn" onclick="closeForm()">X</button>
    <h2>Book your Car</h2>
    <form>
        <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" required>
        </div>
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" required>
        </div>
        <div class="form-group">
            <label for="dates">Rental Dates</label>
            <input type="text" id="dates" placeholder="Enter rental dates" required>
        </div>
        <button type="submit">Submit</button>
    </form>
</div>

<footer>
    <p>&copy; 2025 Trinidad Car Rentals</p>
</footer>

<script>
    function openForm(car) {
        document.getElementById("overlay").style.display = "block";
        document.getElementById("popupForm").style.display = "block";
        document.getElementById("popupForm").querySelector("h2").innerText = `Book your ${car}`;
    }

    function closeForm() {
        document.getElementById("overlay").style.display = "none";
        document.getElementById("popupForm").style.display = "none";
    }
</script>

</body>
</html>
